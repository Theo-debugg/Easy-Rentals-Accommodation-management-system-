@model IEnumerable<EasyRentalsStaff.Models.Room>
@{
    ViewData["Title"] = "Rooms";
}

<div class="rooms-page">

    <!-- Page heading -->
    <div class="page-heading">
        <div>
            <h2>Room Dashboard</h2>
            <p>Convenience at your door step</p>
        </div>
        <a asp-action="Add" class="btn-add-room">➕ Add Room</a>
    </div>

    <!-- Summary cards -->
    <div class="summary-grid">
        <div class="summary-card">
            <div class="summary-card-top">
                <span>Total Rooms</span>
                <span class="summary-indicator total-indicator"></span>
            </div>
            <div class="summary-number">@ViewBag.TotalRooms</div>
            <div class="summary-description">All registered rooms</div>
        </div>

        <div class="summary-card">
            <div class="summary-card-top">
                <span>Available Rooms</span>
                <span class="summary-indicator approved-indicator"></span>
            </div>
            <div class="summary-number">@ViewBag.AvailableRooms</div>
            <div class="summary-description">Ready for occupancy</div>
        </div>

        <div class="summary-card">
            <div class="summary-card-top">
                <span>Occupied</span>
                <span class="summary-indicator pending-indicator"></span>
            </div>
            <div class="summary-number">@ViewBag.OccupiedRooms</div>
            <div class="summary-description">Currently in use</div>
        </div>

        <div class="summary-card">
            <div class="summary-card-top">
                <span>Maintenance</span>
                <span class="summary-indicator declined-indicator"></span>
            </div>
            <div class="summary-number">@ViewBag.MaintenanceRooms</div>
            <div class="summary-description">Under repair</div>
        </div>
    </div>

    <!-- Search and filters -->
    <form asp-action="Index" method="get" class="request-toolbar">
        <div class="search-field">
            <span class="search-symbol" aria-hidden="true"></span>
            <input type="search" name="searchString" placeholder="Search by room..." value="@Context.Request.Query["searchString"]" aria-label="Search rooms" />
        </div>

        <select name="roomTypeFilter" class="filter-control" aria-label="Filter by type">
            <option value="">All Room Types</option>
            <option value="Single">Single</option>
            <option value="Sharing">Sharing</option>
        </select>

        <select name="statusFilter" class="filter-control" aria-label="Filter by status">
            <option value="">All Statuses</option>
            <option value="Available">Available</option>
            <option value="Occupied">Occupied</option>
            <option value="Maintenance">Maintenance</option>
        </select>
        
        <button type="submit" class="btn-search">Filter</button>
    </form>

    <!-- Rooms Panel (using the white card style) -->
    <div class="requests-panel">
        <div class="table-heading">
            <div>
                <h3>All Rooms</h3>
                <p>Manage property inventory</p>
            </div>
            <span class="request-count">@Model.Count() rooms</span>
        </div>

        <!-- Grid Layout inside the clean panel -->
        <div class="rooms-grid-container">
            @if (!Model.Any())
            {
                <div class="empty-state">
                    <div class="empty-state-mark" aria-hidden="true">—</div>
                    <h4>No rooms found</h4>
                    <p>Get started by adding a new room to the system.</p>
                </div>
            }
            else
            {
                <div class="rooms-grid">
                    @foreach (var room in Model)
                    {
                        <div class="room-card">
                            <div class="room-card-header">
                                <span class="room-status @room.Availability?.ToLower()">@room.Availability</span>
                                <strong>R @room.Price</strong>
                            </div>
                            
                            <h4>@room.RoomNumber</h4>
                            
                            <p class="room-details">
                                @room.RoomType 
                                @if (!string.IsNullOrEmpty(room.Amenities))
                                {
                                    <span> | @room.Amenities.Replace(",", ", ")</span>
                                }
                            </p>

                            <div class="room-actions">
                                <a asp-action="Edit" asp-route-id="@room.Id" class="btn-action">Edit</a>
                                <button type="button" class="btn-action">View</button>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

<style>
    /* Reusing your exact design system, scoped to .rooms-page */
    .rooms-page {
        width: 100%;
        max-width: 100%;
        color: #263445;
        font-family: inherit;
    }

    .rooms-page *, .rooms-page *::before, .rooms-page *::after {
        box-sizing: border-box;
    }

    /* Page Heading */
    .rooms-page .page-heading {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
    }

    .rooms-page .page-heading h2 {
        margin: 0 0 6px;
        font-size: 25px;
        font-weight: 700;
        letter-spacing: -0.5px;
        color: #263445;
    }

    .rooms-page .page-heading p {
        margin: 0;
        font-size: 13px;
        color: #788493;
    }

    .rooms-page .btn-add-room {
        padding: 10px 20px;
        background: #fff;
        border: 1px solid #d0d7e2;
        border-radius: 7px;
        color: #263445;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.2s;
    }
    
    .rooms-page .btn-add-room:hover {
        background: #f8fafc;
        border-color: #263445;
    }

    /* Summary Cards */
    .rooms-page .summary-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 16px;
        margin-bottom: 22px;
    }

    .rooms-page .summary-card {
        padding: 18px 19px 16px;
        background: #fff;
        border: 1px solid #e6eaf0;
        border-radius: 10px;
        box-shadow: 0 2px 7px rgba(31, 45, 61, 0.035);
    }

    .rooms-page .summary-card-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        color: #687587;
        font-size: 12px;
        font-weight: 600;
    }

    .rooms-page .summary-indicator {
        display: inline-block;
        flex: 0 0 8px;
        width: 8px;
        height: 8px;
        border-radius: 50%;
    }

    .rooms-page .total-indicator { background: #7892b4; }
    .rooms-page .pending-indicator { background: #dba23e; }
    .rooms-page .approved-indicator { background: #39a77a; }
    .rooms-page .declined-indicator { background: #d96b70; }

    .rooms-page .summary-number {
        margin: 13px 0 5px;
        font-size: 29px;
        font-weight: 700;
        color: #263445;
    }

    .rooms-page .summary-description {
        font-size: 11px;
        color: #8993a1;
    }

    /* Filter Toolbar */
    .rooms-page .request-toolbar {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 10px;
        margin-bottom: 20px;
    }

    .rooms-page .search-field {
        position: relative;
        flex: 1 1 260px;
        max-width: 320px;
    }

    .rooms-page .search-field input,
    .rooms-page .filter-control,
    .rooms-page .btn-search {
        height: 40px;
        border: 1px solid #e1e6ed;
        border-radius: 7px;
        background-color: #fff;
        color: #475467;
        font: inherit;
        font-size: 12px;
        outline: none;
    }

    .rooms-page .search-field input {
        width: 100%;
        padding: 0 12px 0 36px;
    }

    .rooms-page .search-symbol {
        position: absolute;
        top: 12px;
        left: 13px;
        width: 12px;
        height: 12px;
        border: 1.7px solid #8995a5;
        border-radius: 50%;
    }

    .rooms-page .search-symbol::after {
        position: absolute;
        content: "";
        width: 5px;
        height: 1.7px;
        right: -4px;
        bottom: -2px;
        background: #8995a5;
        transform: rotate(45deg);
        border-radius: 2px;
    }

    .rooms-page .filter-control {
        flex: 0 1 150px;
        padding: 0 10px;
    }

    .rooms-page .btn-search {
        padding: 0 20px;
        background: #f8fafc;
        cursor: pointer;
        font-weight: 600;
    }

    .rooms-page .btn-search:hover {
        background: #e2e8f0;
    }

    /* Main Panel */
    .rooms-page .requests-panel {
        background: #fff;
        border: 1px solid #e6eaf0;
        border-radius: 10px;
        box-shadow: 0 2px 7px rgba(31, 45, 61, 0.035);
    }

    .rooms-page .table-heading {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 19px 20px;
        border-bottom: 1px solid #edf0f4;
    }

    .rooms-page .table-heading h3 {
        margin: 0 0 5px;
        font-size: 15px;
        font-weight: 700;
        color: #263445;
    }

    .rooms-page .table-heading p {
        margin: 0;
        font-size: 12px;
        color: #8993a1;
    }

    .rooms-page .request-count {
        padding: 5px 9px;
        border: 1px solid #e6eaf0;
        border-radius: 5px;
        background: #f8fafc;
        color: #657286;
        font-size: 11px;
        font-weight: 600;
    }

    /* Room Grid */
    .rooms-page .rooms-grid-container {
        padding: 20px;
        background: #f8fafc; /* Soft background for grid area */
        border-bottom-left-radius: 10px;
        border-bottom-right-radius: 10px;
    }

    .rooms-page .rooms-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 16px;
    }

    .rooms-page .room-card {
        background: #fff;
        border: 1px solid #e6eaf0;
        border-radius: 8px;
        padding: 16px;
        display: flex;
        flex-direction: column;
    }

    .rooms-page .room-card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 12px;
        font-size: 14px;
    }

    .rooms-page .room-card h4 {
        margin: 0 0 6px;
        font-size: 18px;
        font-weight: 700;
        color: #263445;
    }

    .rooms-page .room-details {
        font-size: 12px;
        color: #788493;
        margin: 0 0 16px;
        flex-grow: 1;
    }

    .rooms-page .room-actions {
        display: flex;
        gap: 8px;
        margin-top: auto;
    }

    .rooms-page .btn-action {
        flex: 1;
        text-align: center;
        padding: 6px 0;
        background: #fff;
        border: 1px solid #d0d7e2;
        border-radius: 5px;
        color: #263445;
        font-size: 12px;
        font-weight: 600;
        text-decoration: none;
        cursor: pointer;
        transition: all 0.2s;
    }

    .rooms-page .btn-action:hover {
        background: #f1f5f9;
    }

    /* Status Badges */
    .rooms-page .room-status {
        padding: 4px 8px;
        border-radius: 4px;
        font-size: 10px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .rooms-page .room-status.available { background: #e6f6ef; color: #39a77a; }
    .rooms-page .room-status.occupied { background: #fdf4e6; color: #dba23e; }
    .rooms-page .room-status.maintenance { background: #fce8e9; color: #d96b70; }

    /* Empty State */
    .rooms-page .empty-state {
        padding: 44px 20px;
        text-align: center;
    }
    .rooms-page .empty-state-mark {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 40px;
        margin: 0 auto 13px;
        border: 1px solid #e5eaf0;
        border-radius: 10px;
        background: #fff;
        color: #a2adbb;
        font-size: 20px;
    }
    .rooms-page .empty-state h4 {
        margin: 0 0 7px;
        color: #465366;
        font-size: 13px;
        font-weight: 700;
    }
    .rooms-page .empty-state p {
        margin: 0;
        color: #8b96a5;
        font-size: 12px;
    }

    @@media (max-width: 1100px) {
        .rooms-page .summary-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }
    @@media (max-width: 700px) {
        .rooms-page .request-toolbar { flex-direction: column; align-items: stretch; }
        .rooms-page .filter-control { flex: 1; }
        .rooms-page .search-field { max-width: none; }
    }
    @@media (max-width: 420px) {
        .rooms-page .summary-grid { gap: 10px; }
    }
</style>

