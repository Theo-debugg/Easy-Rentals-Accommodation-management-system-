@model EasyRentalsStaff.ViewModel.RoomViewModel
@{
    ViewData["Title"] = "Edit Room";
}

@section Styles {
    <link rel="stylesheet" href="~/css/roomAdd.css" asp-append-version="true" />
}

<div class="rooms-page">
    <!-- Breadcrumb & Header -->
    <div class="page-heading mb-4">
        <div>
            <div class="text-muted small mb-2 fw-bold" style="letter-spacing: 0.5px; text-transform: uppercase;">Rooms > Edit Room</div>
            <h2>Edit Room</h2>
            <p>Update the details for this room.</p>
        </div>
        <a asp-action="Index" class="btn-add-room">← Back to Rooms</a>
    </div>

    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
        <input type="hidden" asp-for="Id" />
        <!-- Validation Summary (shows Supabase errors) -->
        <div asp-validation-summary="All" class="text-danger mb-3" style="font-size: 13px;"></div>

        <div class="row">
            <!-- Left Column (Main Info) -->
            <div class="col-lg-8">
                <!-- Basic Info Panel -->
                <div class="form-panel">
                    <h5>Basic info</h5>

                    <div class="form-group">
                        <label asp-for="PropertyId">Property ID (UUID)</label>
                        <input asp-for="PropertyId" class="form-control-custom" readonly />
                        <span asp-validation-for="PropertyId" class="text-danger" style="font-size: 11px;"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="RoomNumber">Room Number</label>
                        <input asp-for="RoomNumber" class="form-control-custom" placeholder="e.g. Room 01" />
                        <span asp-validation-for="RoomNumber" class="text-danger" style="font-size: 11px;"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="RoomType">Room Type</label>
                        <select asp-for="RoomType" class="form-control-custom" asp-items="@(new SelectList(Model.RoomTypeOptions))">
                            <option value="">-- Select Room Type --</option>
                        </select>
                        <span asp-validation-for="RoomType" class="text-danger" style="font-size: 11px;"></span>
                    </div>

                    <div class="form-group mb-0">
                        <label asp-for="Description">Description</label>
                        <textarea asp-for="Description" class="form-control-custom" rows="4" placeholder="Enter room details..."></textarea>
                    </div>
                </div>

                <!-- Pricing & Availability Panel -->
                <div class="form-panel">
                    <h5>Pricing & availability</h5>

                    <div class="form-group">
                        <label asp-for="Price">Monthly Rent (R)</label>
                        <input asp-for="Price" class="form-control-custom" type="number" step="0.01" placeholder="e.g. 3200" />
                        <span asp-validation-for="Price" class="text-danger" style="font-size: 11px;"></span>
                    </div>

                    <div class="form-group mb-0">
                        <label>Status</label>
                        <div class="status-radio-group">
                            <label class="status-radio-label">
                                <input type="radio" asp-for="Availability" value="Available" onclick="updateRadioStyles()">
                                Available
                            </label>
                            <label class="status-radio-label">
                                <input type="radio" asp-for="Availability" value="Occupied" onclick="updateRadioStyles()">
                                Occupied
                            </label>
                            <label class="status-radio-label">
                                <input type="radio" asp-for="Availability" value="Maintenance" onclick="updateRadioStyles()">
                                Maintenance
                            </label>
                        </div>
                    </div>
                </div>

                <!-- Amenities Panel -->
                <div class="form-panel mb-0">
                    <h5>Amenities</h5>
                    <div class="amenities-grid">
                        <label class="amenity-checkbox-label">
                            <input type="checkbox" asp-for="HasWiFi"> Wi-Fi
                        </label>
                        <label class="amenity-checkbox-label">
                            <input type="checkbox" asp-for="HasPool"> Pool
                        </label>
                        <label class="amenity-checkbox-label">
                            <input type="checkbox" asp-for="HasParking"> Parking
                        </label>
                        <label class="amenity-checkbox-label">
                            <input type="checkbox" asp-for="HasLaundry"> Laundry
                        </label>
                    </div>
                </div>
            </div>

            <!-- Right Column (Sidebar Info) -->
            <div class="col-lg-4">
                <!-- Photos Panel -->
                <div class="form-panel" id="photoPanel" data-room="@Model.Id">
                    <h5>Room Photos</h5>
                    <div class="row g-2" id="photoGrid">
                        @foreach (var p in Model.Photos)
                        {
                            <div class="col-6">
                                <div class="photo-box" style="position:relative;overflow:hidden;padding:0;border-style:solid;">
                                    <img src="@p.PhotoUrl" alt="Room photo" style="width:100%;height:100%;object-fit:contain;background:#f8fafc;" />
                                    <button type="button" class="photo-del" data-photo="@p.Id" aria-label="Delete photo"
                                            style="position:absolute;top:4px;right:4px;width:22px;height:22px;border:0;border-radius:50%;background:rgba(0,0,0,.65);color:#fff;cursor:pointer;line-height:1;">&times;</button>
                                </div>
                            </div>
                        }
                        <div class="col-6">
                            <label class="photo-box" for="photoInput" style="cursor:pointer;" title="Add a photo">+</label>
                        </div>
                    </div>
                    <input type="file" id="photoInput" accept="image/jpeg,image/png,image/webp" hidden />
                    <p id="photoMsg" class="mb-0 mt-2" style="font-size:12px;color:#64748b;" role="status">JPG, PNG or WebP, up to 5 MB. Photos upload straight away.</p>
                </div>

                <!-- Summary Panel -->
                <div class="form-panel">
                    <h5>Room Summary</h5>
                    <ul class="summary-list">
                        <li><span>Current Status</span> <strong>@Model.Availability</strong></li>
                        <li><span>Last updated</span> <strong>On save</strong></li>
                        <li><span>Updated by</span> <strong>@Context.Session.GetString("staff_name")</strong></li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Action Buttons -->
        <div class="form-actions">
            <a asp-action="Index" class="btn-cancel">Cancel</a>
            <button type="submit" class="btn-save">Save Changes</button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        // Highlight selected radio buttons on load and click
        function updateRadioStyles() {
            document.querySelectorAll('.status-radio-label').forEach(label => {
                const radio = label.querySelector('input[type="radio"]');
                if (radio.checked) {
                    label.classList.add('selected');
                } else {
                    label.classList.remove('selected');
                }
            });
        }

        document.addEventListener("DOMContentLoaded", function() {
            updateRadioStyles();
        });

        // ---- Room photos: upload / delete without leaving the page ----
        (function () {
            var panel = document.getElementById('photoPanel');
            if (!panel) return;
            var roomId = panel.getAttribute('data-room');
            var grid = document.getElementById('photoGrid');
            var input = document.getElementById('photoInput');
            var msg = document.getElementById('photoMsg');
            var tokenEl = document.querySelector('input[name="__RequestVerificationToken"]');

            function say(text, bad) { msg.textContent = text; msg.style.color = bad ? '#b3261e' : '#64748b'; }

            function post(url, body) {
                return fetch(url, {
                    method: 'POST',
                    headers: { 'Accept': 'application/json', 'RequestVerificationToken': tokenEl ? tokenEl.value : '' },
                    body: body
                }).then(function (r) {
                    return r.json().catch(function () { return { error: 'Your session may have ended. Please sign in again.' }; })
                        .then(function (j) { if (!r.ok) { throw new Error(j.error || 'Request failed.'); } return j; });
                });
            }

            function render(photos) {
                grid.innerHTML = '';
                photos.forEach(function (p) {
                    var col = document.createElement('div'); col.className = 'col-6';
                    var box = document.createElement('div'); box.className = 'photo-box';
                    box.style.cssText = 'position:relative;overflow:hidden;padding:0;border-style:solid;background:#f8fafc;';
                    var img = document.createElement('img'); img.src = p.photoUrl; img.alt = 'Room photo';
                    img.style.cssText = 'width:100%;height:100%;object-fit:contain;background:#f8fafc;';
                    var del = document.createElement('button'); del.type = 'button'; del.className = 'photo-del';
                    del.setAttribute('data-photo', p.id); del.setAttribute('aria-label', 'Delete photo');
                    del.textContent = '\u00d7';
                    del.style.cssText = 'position:absolute;top:4px;right:4px;width:22px;height:22px;border:0;border-radius:50%;background:rgba(0,0,0,.65);color:#fff;cursor:pointer;line-height:1;';
                    box.appendChild(img); box.appendChild(del); col.appendChild(box); grid.appendChild(col);
                });
                var addCol = document.createElement('div'); addCol.className = 'col-6';
                var add = document.createElement('label'); add.className = 'photo-box'; add.setAttribute('for', 'photoInput');
                add.style.cursor = 'pointer'; add.title = 'Add a photo'; add.textContent = '+';
                addCol.appendChild(add); grid.appendChild(addCol);
            }

            input.addEventListener('change', function () {
                if (!input.files.length) return;
                var fd = new FormData(); fd.append('photo', input.files[0]);
                say('Uploading...');
                post('/Rooms/UploadPhoto/' + roomId, fd)
                    .then(function (j) { render(j.photos); say('Photo uploaded.'); })
                    .catch(function (e) { say(e.message, true); })
                    .then(function () { input.value = ''; });
            });

            grid.addEventListener('click', function (e) {
                var btn = e.target.closest('.photo-del');
                if (!btn) return;
                if (!confirm('Delete this photo?')) return;
                say('Deleting...');
                post('/Rooms/DeletePhoto/' + roomId + '?photoId=' + encodeURIComponent(btn.getAttribute('data-photo')))
                    .then(function (j) { render(j.photos); say('Photo deleted.'); })
                    .catch(function (err) { say(err.message, true); });
            });
        })();
    </script>
}
