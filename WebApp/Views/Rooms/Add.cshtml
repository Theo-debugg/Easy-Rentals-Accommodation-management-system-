@model EasyRentalsStaff.ViewModel.RoomViewModel
@{
    ViewData["Title"] = "Add Room";
}

<div class="rooms-page">
    <!-- Breadcrumb & Header -->
    <div class="page-heading mb-4">
        <div>
            <div class="text-muted small mb-2 fw-bold" style="letter-spacing: 0.5px; text-transform: uppercase;">Rooms > Add Room</div>
            <h2>Add Room</h2>
            <p>Create a new room listing for the property.</p>
        </div>
        <a asp-action="Index" class="btn-add-room">← Back to Rooms</a>
    </div>

    <form asp-action="Add" method="post">
        <!-- Validation Summary (shows Supabase errors) -->
        <div asp-validation-summary="All" class="text-danger mb-3" style="font-size: 13px;"></div>

        <div class="row">
            <!-- Left Column (Main Info) -->
            <div class="col-lg-8">
                <!-- Basic Info Panel -->
                <div class="form-panel">
                    <h5>Basic info</h5>

                    <div class="form-group">
                        <label asp-for="PropertyId">Property ID (UUID)</label>
                        <input asp-for="PropertyId" class="form-control-custom" placeholder="Paste Property UUID here" />
                        <span asp-validation-for="PropertyId" class="text-danger" style="font-size: 11px;"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="RoomNumber">Room Number</label>
                        <input asp-for="RoomNumber" class="form-control-custom" placeholder="e.g. Room 01" />
                        <span asp-validation-for="RoomNumber" class="text-danger" style="font-size: 11px;"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="RoomType">Room Type</label>
                        <select asp-for="RoomType" class="form-control-custom" asp-items="@(new SelectList(Model.RoomTypeOptions))">
                            <option value="">-- Select Room Type --</option>
                        </select>
                        <span asp-validation-for="RoomType" class="text-danger" style="font-size: 11px;"></span>
                    </div>

                    <div class="form-group mb-0">
                        <label asp-for="Description">Description</label>
                        <textarea asp-for="Description" class="form-control-custom" rows="4" placeholder="Enter room details..."></textarea>
                    </div>
                </div>

                <!-- Pricing & Availability Panel -->
                <div class="form-panel">
                    <h5>Pricing & availability</h5>

                    <div class="form-group">
                        <label asp-for="Price">Monthly Rent (R)</label>
                        <input asp-for="Price" class="form-control-custom" type="number" step="0.01" placeholder="e.g. 3200" />
                        <span asp-validation-for="Price" class="text-danger" style="font-size: 11px;"></span>
                    </div>

                    <div class="form-group mb-0">
                        <label>Status</label>
                        <div class="status-radio-group">
                            <label class="status-radio-label">
                                <input type="radio" asp-for="Availability" value="Available" onclick="updateRadioStyles()">
                                Available
                            </label>
                            <label class="status-radio-label">
                                <input type="radio" asp-for="Availability" value="Occupied" onclick="updateRadioStyles()">
                                Occupied
                            </label>
                            <label class="status-radio-label">
                                <input type="radio" asp-for="Availability" value="Maintenance" onclick="updateRadioStyles()">
                                Maintenance
                            </label>
                        </div>
                    </div>
                </div>

                <!-- Amenities Panel -->
                <div class="form-panel mb-0">
                    <h5>Amenities</h5>
                    <div class="amenities-grid">
                        <label class="amenity-checkbox-label">
                            <input type="checkbox" asp-for="HasWiFi"> Wi-Fi
                        </label>
                        <label class="amenity-checkbox-label">
                            <input type="checkbox" asp-for="HasPool"> Pool
                        </label>
                        <label class="amenity-checkbox-label">
                            <input type="checkbox" asp-for="HasParking"> Parking
                        </label>
                        <label class="amenity-checkbox-label">
                            <input type="checkbox" asp-for="HasLaundry"> Laundry
                        </label>
                    </div>
                </div>
            </div>

            <!-- Right Column (Sidebar Info) -->
            <div class="col-lg-4">
                <!-- Photos Panel -->
                <div class="form-panel">
                    <h5>Room Photos</h5>
                    <div class="row g-2">
                        <div class="col-6"><div class="photo-box">+</div></div>
                        <div class="col-6"><div class="photo-box">+</div></div>
                        <div class="col-6"><div class="photo-box">+</div></div>
                        <div class="col-6"><div class="photo-box">+</div></div>
                    </div>
                </div>

                <!-- Summary Panel -->
                <div class="form-panel">
                    <h5>Room Summary</h5>
                    <ul class="summary-list">
                        <li><span>Current Status</span> <strong>Draft</strong></li>
                        <li><span>Last updated</span> <strong>Just now</strong></li>
                        <li><span>Updated by</span> <strong>@Context.Session.GetString("staff_name")</strong></li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Action Buttons -->
        <div class="form-actions">
            <a asp-action="Index" class="btn-cancel">Cancel</a>
            <button type="submit" class="btn-save">Save Room</button>
        </div>
    </form>
</div>

<style>
    /* --- Reusing your specific Viewing Requests Design System --- */
    .rooms-page {
        width: 100%;
        max-width: 100%;
        color: #263445;
        font-family: inherit;
    }

        .rooms-page *, .rooms-page *::before, .rooms-page *::after {
            box-sizing: border-box;
        }

        /* Page Heading */
        .rooms-page .page-heading {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            margin-bottom: 24px;
        }

            .rooms-page .page-heading h2 {
                margin: 0 0 6px;
                font-size: 25px;
                font-weight: 700;
                letter-spacing: -0.5px;
            }

            .rooms-page .page-heading p {
                margin: 0;
                font-size: 13px;
                color: #788493;
            }

        .rooms-page .btn-add-room {
            padding: 10px 20px;
            background: #fff;
            border: 1px solid #d0d7e2;
            border-radius: 7px;
            color: #263445;
            font-size: 13px;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.2s;
        }

            .rooms-page .btn-add-room:hover {
                background: #f8fafc;
                border-color: #263445;
            }

    /* Form Panels */
    .form-panel {
        background: #fff;
        border: 1px solid #e6eaf0;
        border-radius: 10px;
        padding: 24px;
        margin-bottom: 20px;
        box-shadow: 0 2px 7px rgba(31, 45, 61, 0.035);
    }

        .form-panel h5 {
            font-size: 15px;
            font-weight: 700;
            margin-bottom: 20px;
            color: #263445;
            padding-bottom: 12px;
            border-bottom: 1px solid #edf0f4;
        }

    /*Form Inputs*/
    .form-group {
        margin-bottom: 18px;
    }

        .form-group label {
            display: block;
            font-size: 12px;
            font-weight: 600;
            color: #475467;
            margin-bottom: 6px;
        }

    .form-control-custom {
        width: 100%;
        height: 42px;
        padding: 0 14px;
        border: 1px solid #e1e6ed;
        border-radius: 7px;
        background-color: #fff;
        color: #263445;
        font-size: 13px;
        outline: none;
        transition: border-color 0.2s;
    }

        .form-control-custom:focus {
            border-color: #7892b4;
            box-shadow: 0 0 0 3px rgba(120, 146, 180, 0.1);
        }

    textarea.form-control-custom {
        height: auto;
        padding: 12px 14px;
        resize: vertical;
        min-height: 100px;
    }

    /* Radio Buttons (Status) */
    .status-radio-group {
        display: flex;
        gap: 10px;
    }

    .status-radio-label {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 10px;
        border: 1px solid #e1e6ed;
        border-radius: 7px;
        font-size: 12px;
        font-weight: 600;
        color: #475467;
        cursor: pointer;
        transition: all 0.2s;
    }

        .status-radio-label input[type="radio"] {
            display: none;
        }

        .status-radio-label:hover {
            background-color: #f8fafc;
        }

        .status-radio-label.selected {
            border-color: #7892b4;
            background-color: #f0f4f8;
            color: #263445;
        }

    /* Amenities Checkboxes */
    .amenities-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 12px;
    }

    .amenity-checkbox-label {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 10px 14px;
        border: 1px solid #e1e6ed;
        border-radius: 7px;
        font-size: 12px;
        font-weight: 500;
        color: #475467;
        cursor: pointer;
        transition: background 0.2s;
    }

        .amenity-checkbox-label:hover {
            background-color: #f8fafc;
        }

    /* Photos Placeholder */
    .photo-box {
        background-color: #f8fafc;
        border: 1px dashed #cbd5e1;
        height: 80px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 7px;
        color: #94a3b8;
        font-size: 24px;
        margin-bottom: 15px;
        cursor: pointer;
    }

    /* Summary Box */
    .summary-list {
        list-style: none;
        padding: 0;
        margin: 0;
    }

        .summary-list li {
            display: flex;
            justify-content: space-between;
            font-size: 12px;
            margin-bottom: 10px;
            color: #64748b;
        }

            .summary-list li strong {
                color: #263445;
            }

    /* Action Buttons */
    .form-actions {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        margin-top: 10px;
    }

    .btn-cancel {
        padding: 10px 20px;
        background: #fff;
        border: 1px solid #d0d7e2;
        border-radius: 7px;
        color: #475467;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
    }

    .btn-save {
        padding: 10px 24px;
        background: #263445;
        border: 1px solid #263445;
        border-radius: 7px;
        color: #fff;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.2s;
    }

        .btn-save:hover {
            background: #1a2432;
        }
</style>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        // Highlight selected radio buttons on load and click
        function updateRadioStyles() {
            document.querySelectorAll('.status-radio-label').forEach(label => {
                const radio = label.querySelector('input[type="radio"]');
                if (radio.checked) {
                    label.classList.add('selected');
                } else {
                    label.classList.remove('selected');
                }
            });
        }

        document.addEventListener("DOMContentLoaded", function() {
            updateRadioStyles();
        });
    </script>
}