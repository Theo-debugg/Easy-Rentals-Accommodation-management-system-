        }

    @@media (max-width: 1100px) {
        .viewing-requests-page .summary-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 700px) {
        .viewing-requests-page .page-heading h2 {
            font-size: 22px;
        }

        .viewing-requests-page .request-toolbar {
            align-items: stretch;
            flex-direction: column;
        }

        .viewing-requests-page .search-field,
        .viewing-requests-page .filter-control {
            width: 100%;
            max-width: none;
            flex-basis: 40px;
        }

        .viewing-requests-page .table-heading {
            padding: 16px;
        }

        .viewing-requests-page .requests-table thead th {
            padding: 13px 14px;
        }

        .viewing-requests-page .empty-state {
