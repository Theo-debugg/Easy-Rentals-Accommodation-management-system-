        }

        .viewing-requests-page .empty-state h4 {
            margin: 0 0 7px;
            color: #465366;
            font-size: 13px;
            font-weight: 700;
        }

        .viewing-requests-page .empty-state p {
            margin: 0;
            color: #8b96a5;
