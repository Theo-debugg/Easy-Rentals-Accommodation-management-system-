@model ViewingRequestsViewModel
@{
    ViewData["Title"] = "Viewing Requests";
}

<div class="viewing-requests-page">

    <!-- Page heading -->
    <div class="page-heading">
        <div>
            <h2>Viewing Requests</h2>
            <p>Manage and review student accommodation viewing requests.</p>
        </div>
    </div>

    @if (TempData["Message"] is string okMessage)
    {
        <div class="vr-banner vr-ok" role="status">@okMessage</div>
    }
    @if (TempData["Error"] is string errMessage)
    {
        <div class="vr-banner vr-err" role="alert">@errMessage</div>
    }
    @if (!string.IsNullOrEmpty(Model.LoadError))
    {
        <div class="vr-banner vr-err" role="alert">Viewing requests could not be loaded: @Model.LoadError</div>
    }

    <!-- Summary cards -->
    <div class="summary-grid">

        <div class="summary-card">
            <div class="summary-card-top">
                <span>Total Requests</span>
                <span class="summary-indicator total-indicator"></span>
            </div>
            <div class="summary-number">@Model.Total</div>
            <div class="summary-description">All viewing requests</div>
        </div>

        <div class="summary-card">
            <div class="summary-card-top">
                <span>Pending Requests</span>
                <span class="summary-indicator pending-indicator"></span>
            </div>
            <div class="summary-number">@Model.Pending</div>
            <div class="summary-description">Awaiting a decision</div>
        </div>

        <div class="summary-card">
            <div class="summary-card-top">
                <span>Approved Requests</span>
                <span class="summary-indicator approved-indicator"></span>
            </div>
            <div class="summary-number">@Model.Approved</div>
            <div class="summary-description">Approved viewings</div>
        </div>

        <div class="summary-card">
            <div class="summary-card-top">
                <span>Declined Requests</span>
                <span class="summary-indicator declined-indicator"></span>
            </div>
            <div class="summary-number">@Model.Declined</div>
            <div class="summary-description">Declined viewings</div>
        </div>

    </div>

    <!-- Search and filters -->
    <form method="get" asp-controller="ViewingRequests" asp-action="Index" class="request-toolbar">
        <div class="search-field">
            <span class="search-symbol" aria-hidden="true"></span>
            <input type="search" name="q" value="@Model.Q"
                   placeholder="Search student, email or room..."
                   aria-label="Search viewing requests" />
        </div>

        <select name="status" aria-label="Filter by status" class="filter-control">
            <option value="">All Statuses</option>
            <option value="pending" selected="@(Model.StatusFilter == "pending")">Pending</option>
            <option value="approved" selected="@(Model.StatusFilter == "approved")">Approved</option>
            <option value="declined" selected="@(Model.StatusFilter == "declined")">Declined</option>
        </select>

        <select name="room" aria-label="Filter by room" class="filter-control">
            <option value="">All Rooms</option>
            @foreach (var r in Model.Rooms)
            {
                <option value="@r" selected="@(Model.RoomFilter == r)">@r</option>
            }
        </select>

        <input type="date" name="date" value="@Model.DateFilter"
               aria-label="Filter by date" class="filter-control date-control" />

        <button type="submit" class="vr-btn vr-apply">Apply</button>
        <a asp-action="Index" class="vr-clear">Clear</a>
    </form>

    <!-- Requests table -->
    <div class="requests-panel">

        <div class="table-heading">
            <div>
                <h3>All Requests</h3>
                <p>Viewing appointments submitted by students</p>
            </div>
            <span class="request-count">@Model.Items.Count @(Model.Items.Count == 1 ? "request" : "requests")</span>
        </div>

        <div class="table-responsive">
            <table class="requests-table">
                <thead>
                    <tr>
                        <th>Student</th>
                        <th>Room</th>
                        <th>Date and Time</th>
                        <th>Email</th>
                        <th>Status</th>
                        <th class="action-heading">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items.Count == 0)
                    {
                        <tr>
                            <td colspan="6">
                                <div class="empty-state">
                                    <div class="empty-state-mark" aria-hidden="true">&mdash;</div>
                                    <h4>@(Model.Total == 0 ? "No viewing requests yet" : "No requests match your filters")</h4>
                                    <p>@(Model.Total == 0 ? "New requests will appear here when students book a viewing in the app." : "Try clearing the search or filters.")</p>
                                </div>
                            </td>
                        </tr>
                    }
                    @foreach (var r in Model.Items)
                    {
                        <tr>
                            <td><strong>@r.Student</strong></td>
                            <td class="vr-room-cell">
                                <span class="vr-room-name">@r.Room</span>
                                @if (!string.IsNullOrEmpty(r.Property))
                                {
                                    <span class="vr-property-name"> · @r.Property</span>
                                }
                            </td>
                            <td class="vr-when-cell">@r.When</td>
                            <td class="vr-email-cell">@r.Email</td>
                            <td><span class="vr-status vr-@r.Status">@r.StatusLabel</span></td>
                            <td class="vr-actions">
                                <button type="button" class="vr-btn vr-action" data-viewing-action
                                        data-id="@r.Id" data-student="@r.Student" data-email="@r.Email"
                                        data-property="@r.Property" data-address="@r.Address" data-room="@r.Room"
                                        data-when="@r.When" data-status="@r.Status" data-status-label="@r.StatusLabel">
                                    Action
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

<div class="vr-backdrop" id="vr-backdrop" hidden></div>
<aside class="vr-drawer" id="vr-drawer" role="dialog" aria-modal="true"
       aria-labelledby="vr-drawer-title" aria-hidden="true">
    <header class="vr-drawer-head">
        <div>
            <h2 id="vr-drawer-title">Viewing request</h2>
            <p id="vr-drawer-status" class="vr-status"></p>
        </div>
        <button type="button" class="vr-close" id="vr-close" aria-label="Close">&times;</button>
    </header>
    <div class="vr-drawer-body">
        <dl class="vr-details">
            <div><dt>Student</dt><dd id="vr-student"></dd></div>
            <div><dt>Email</dt><dd id="vr-email"></dd></div>
            <div><dt>Property</dt><dd id="vr-property"></dd></div>
            <div><dt>Address</dt><dd id="vr-address"></dd></div>
            <div><dt>Room</dt><dd id="vr-room"></dd></div>
            <div><dt>Date and time</dt><dd id="vr-when"></dd></div>
        </dl>
    </div>
    <footer class="vr-drawer-actions">
        <form method="post" asp-controller="ViewingRequests" asp-action="Decide" id="vr-approve-form">
            <input type="hidden" name="id" id="vr-approve-id" />
            <input type="hidden" name="decision" value="approved" />
            <button type="submit" class="vr-btn vr-approve">Approve</button>
        </form>
        <form method="post" asp-controller="ViewingRequests" asp-action="Decide" id="vr-decline-form">
            <input type="hidden" name="id" id="vr-decline-id" />
            <input type="hidden" name="decision" value="declined" />
            <button type="submit" class="vr-btn vr-decline">Decline</button>
        </form>
    </footer>
</aside>

    </div>

</div>

<style>
    .vr-banner { padding: 12px 16px; border-radius: 6px; margin: 0 0 16px; font-size: 14px; font-weight: 600; }
    .vr-ok  { background: #e6f4ea; color: #1b5e32; border-left: 4px solid #2e8b4f; }
    .vr-err { background: #fdecea; color: #8a1c14; border-left: 4px solid #c92a20; }
    .vr-status { display: inline-block; padding: 4px 12px; border-radius: 999px; font-size: 12px; font-weight: 700; }
    .vr-pending  { background: #fff1cc; color: #7a4b00; }
    .vr-approved { background: #e6f4ea; color: #1b5e32; }
    .vr-declined { background: #fdecea; color: #8a1c14; }
    .vr-actions { white-space: nowrap; text-align: right; }
    .vr-btn { border: 0; border-radius: 6px; padding: 8px 14px; font-size: 13px; font-weight: 700; cursor: pointer; }
    .vr-approve { background: #2e8b4f; color: #fff; }
    .vr-decline { background: #fff; color: #b3261e; border: 1px solid #b3261e; }
    .vr-action { background: #fff; color: #5218c2; border: 1px solid #6725e6; }
    .vr-action:hover { background: #f3edff; }
    .vr-apply { background: #6725e6; color: #fff; padding: 10px 18px; }
    .vr-clear { align-self: center; margin-left: 6px; color: #5218c2; font-weight: 600; font-size: 13px; text-decoration: none; }
    .request-toolbar { flex-wrap: wrap; }
</style>

<style>
    .vr-backdrop { position: fixed; inset: 0; z-index: 50; background: rgba(20, 10, 40, .35); }
    .vr-backdrop[hidden] { display: none; }
    .vr-drawer { position: fixed; top: 0; right: 0; bottom: 0; z-index: 60; width: min(520px, 100%); background: #fff; border-top: 4px solid #6725e6; box-shadow: -16px 0 44px rgba(30, 20, 60, .22); display: flex; flex-direction: column; transform: translateX(100%); visibility: hidden; transition: transform .22s ease, visibility 0s linear .22s; }
    .vr-drawer.open { transform: none; visibility: visible; transition-delay: 0s; }
    .vr-drawer-head { display: flex; justify-content: space-between; gap: 12px; padding: 18px 20px 14px; border-bottom: 1px solid #ecebf0; }
    .vr-drawer-head h2 { margin: 0 0 8px; font-size: 19px; }
    .vr-close { width: 36px; height: 36px; background: none; border: 0; border-radius: 6px; color: #555; font-size: 28px; line-height: 1; cursor: pointer; }
    .vr-close:hover { background: #f3edff; }
    .vr-drawer-body { flex: 1; overflow-y: auto; padding: 20px; background: #fcfcfd; }
    .vr-details { margin: 0; background: #fff; border: 1px solid #ecebf0; border-radius: 8px; }
    .vr-details div { padding: 14px 16px; border-bottom: 1px solid #f0eff4; }
    .vr-details div:last-child { border-bottom: 0; }
    .vr-details dt { color: #788493; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; }
    .vr-details dd { margin: 5px 0 0; color: #263445; font-size: 14px; overflow-wrap: anywhere; }
    .vr-drawer-actions { display: flex; gap: 10px; padding: 14px 20px 18px; border-top: 1px solid #ecebf0; }
    .vr-drawer-actions form { flex: 1; }
    .vr-drawer-actions .vr-btn { width: 100%; }
    .vr-drawer-actions[ data-complete ] { display: none; }
</style>

<script>
    (function () {
        var drawer = document.getElementById('vr-drawer');
        var backdrop = document.getElementById('vr-backdrop');
        if (!drawer || !backdrop) return;
        var fields = ['student', 'email', 'property', 'address', 'room', 'when'];
        var actions = drawer.querySelector('.vr-drawer-actions');
        function close() { drawer.classList.remove('open'); drawer.setAttribute('aria-hidden', 'true'); backdrop.hidden = true; document.body.classList.remove('drawer-open'); }
        document.querySelectorAll('[data-viewing-action]').forEach(function (button) {
            button.addEventListener('click', function () {
                fields.forEach(function (name) { document.getElementById('vr-' + name).textContent = button.dataset[name] || '-'; });
                var status = button.dataset.status || 'pending';
                var statusEl = document.getElementById('vr-drawer-status');
                statusEl.className = 'vr-status vr-' + status;
                statusEl.textContent = button.dataset.statusLabel || status;
                document.getElementById('vr-approve-id').value = button.dataset.id;
                document.getElementById('vr-decline-id').value = button.dataset.id;
                // Staff may change a previous decision as well as decide pending requests.
                actions.hidden = false;
                drawer.classList.add('open'); drawer.setAttribute('aria-hidden', 'false'); backdrop.hidden = false; document.body.classList.add('drawer-open');
            });
        });
        document.getElementById('vr-close').addEventListener('click', close);
        backdrop.addEventListener('click', close);
        document.addEventListener('keydown', function (e) { if (e.key === 'Escape') close(); });
    }());
</script>

<style>
    .viewing-requests-page {
        width: 100%;
        max-width: 100%;
        color: #263445;
        font-family: inherit;
    }

        .viewing-requests-page *,
        .viewing-requests-page *::before,
        .viewing-requests-page *::after {
            box-sizing: border-box;
        }

        .viewing-requests-page .page-heading {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 24px;
        }

            .viewing-requests-page .page-heading h2 {
                margin: 0 0 6px;
                font-size: 25px;
                line-height: 1.3;
                font-weight: 700;
                letter-spacing: -0.5px;
                color: #263445;
            }

            .viewing-requests-page .page-heading p {
                margin: 0;
                font-size: 13px;
                line-height: 1.6;
                color: #788493;
            }

        /* Compact, evenly aligned summary cards */
        .viewing-requests-page .summary-grid {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 16px;
            margin-bottom: 22px;
        }

        .viewing-requests-page .summary-card {
            min-width: 0;
            padding: 18px 19px 16px;
            background: #fff;
            border: 1px solid #e6eaf0;
            border-radius: 10px;
            box-shadow: 0 2px 7px rgba(31, 45, 61, 0.035);
        }

        .viewing-requests-page .summary-card-top {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
            color: #687587;
            font-size: 12px;
            font-weight: 600;
        }

        .viewing-requests-page .summary-indicator {
            display: inline-block;
            flex: 0 0 8px;
            width: 8px;
            height: 8px;
            border-radius: 50%;
        }

        .viewing-requests-page .total-indicator {
            background: #7892b4;
        }

        .viewing-requests-page .pending-indicator {
            background: #dba23e;
        }

        .viewing-requests-page .approved-indicator {
            background: #39a77a;
        }

        .viewing-requests-page .declined-indicator {
            background: #d96b70;
        }

        .viewing-requests-page .summary-number {
            margin: 13px 0 5px;
            font-size: 29px;
            line-height: 1;
            font-weight: 700;
            color: #263445;
        }

        .viewing-requests-page .summary-description {
            font-size: 11px;
            color: #8993a1;
        }

        /* One compact filter row, aligned to the right */
        .viewing-requests-page .request-toolbar {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 10px;
            margin-bottom: 20px;
        }

        .viewing-requests-page .search-field {
            position: relative;
            flex: 1 1 260px;
            max-width: 320px;
            min-width: 170px;
        }

            .viewing-requests-page .search-field input,
            .viewing-requests-page .filter-control {
                width: 100%;
                height: 40px;
                border: 1px solid #e1e6ed;
                border-radius: 7px;
                background-color: #fff;
                color: #475467;
                font: inherit;
                font-size: 12px;
                outline: none;
            }

            .viewing-requests-page .search-field input {
                padding: 0 12px 0 36px;
            }

                .viewing-requests-page .search-field input::placeholder {
                    color: #9aa4b2;
                }

        .viewing-requests-page .search-symbol {
            position: absolute;
            top: 12px;
            left: 13px;
            width: 12px;
            height: 12px;
            border: 1.7px solid #8995a5;
            border-radius: 50%;
        }

            .viewing-requests-page .search-symbol::after {
                position: absolute;
                content: "";
                width: 5px;
                height: 1.7px;
                right: -4px;
                bottom: -2px;
                background: #8995a5;
                transform: rotate(45deg);
                border-radius: 2px;
            }

        .viewing-requests-page .filter-control {
            flex: 0 1 150px;
            min-width: 125px;
            padding: 0 10px;
        }

        .viewing-requests-page .date-control {
            flex-basis: 155px;
        }

        .viewing-requests-page input:disabled,
        .viewing-requests-page select:disabled {
            opacity: 1;
            cursor: not-allowed;
            background-color: #fff;
            color: #7c8795;
        }

        /* Table panel */
        .viewing-requests-page .requests-panel {
            overflow: hidden;
            background: #fff;
            border: 1px solid #e6eaf0;
            border-radius: 10px;
            box-shadow: 0 2px 7px rgba(31, 45, 61, 0.035);
        }

        .viewing-requests-page .table-heading {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            padding: 19px 20px;
            border-bottom: 1px solid #edf0f4;
        }

            .viewing-requests-page .table-heading h3 {
                margin: 0 0 5px;
                font-size: 15px;
                font-weight: 700;
                color: #263445;
            }

            .viewing-requests-page .table-heading p {
                margin: 0;
                font-size: 12px;
                color: #8993a1;
            }

        .viewing-requests-page .request-count {
            flex-shrink: 0;
            padding: 5px 9px;
            border: 1px solid #e6eaf0;
            border-radius: 5px;
            background: #f8fafc;
            color: #657286;
            font-size: 11px;
