@{
    ViewData["Title"] = "Viewing Requests";
}

<div class="viewing-requests-page">

    <!-- Page heading -->
    <div class="page-heading">
        <div>
            <h2>Viewing Requests</h2>
            <p>Manage and review student accommodation viewing requests.</p>
        </div>
    </div>

    <!-- Summary cards -->
    <div class="summary-grid">

        <div class="summary-card">
            <div class="summary-card-top">
                <span>Total Requests</span>
                <span class="summary-indicator total-indicator"></span>
            </div>
            <div class="summary-number">0</div>
            <div class="summary-description">All viewing requests</div>
        </div>

        <div class="summary-card">
            <div class="summary-card-top">
                <span>Pending Requests</span>
                <span class="summary-indicator pending-indicator"></span>
            </div>
            <div class="summary-number">0</div>
            <div class="summary-description">Awaiting a decision</div>
        </div>

        <div class="summary-card">
            <div class="summary-card-top">
                <span>Approved Requests</span>
                <span class="summary-indicator approved-indicator"></span>
            </div>
            <div class="summary-number">0</div>
            <div class="summary-description">Approved viewings</div>
        </div>

        <div class="summary-card">
            <div class="summary-card-top">
                <span>Declined Requests</span>
                <span class="summary-indicator declined-indicator"></span>
            </div>
            <div class="summary-number">0</div>
            <div class="summary-description">Declined viewings</div>
        </div>

    </div>

    <!-- Search and filters -->
    <div class="request-toolbar">
        <div class="search-field">
            <span class="search-symbol" aria-hidden="true"></span>
            <input type="search"
                   placeholder="Search requests..."
                   aria-label="Search viewing requests"
                   disabled />
        </div>

        <select aria-label="Filter by room"
                class="filter-control"
                disabled>
            <option value="">All Rooms</option>
        </select>

        <input type="date"
               aria-label="Filter by date"
               class="filter-control date-control"
               disabled />
    </div>

    <!-- Requests table -->
    <div class="requests-panel">

        <div class="table-heading">
            <div>
                <h3>All Requests</h3>
                <p>Viewing appointments submitted by students</p>
            </div>
            <span class="request-count">0 requests</span>
        </div>

        <div class="table-responsive">
            <table class="requests-table">
                <thead>
                    <tr>
                        <th>Student ID</th>
                        <th>Room ID</th>
                        <th>Date and Time</th>
                        <th>Email</th>
                        <th>Status</th>
                        <th class="action-heading">Action</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td colspan="6">
                            <div class="empty-state">
                                <div class="empty-state-mark" aria-hidden="true">—</div>
                                <h4>No viewing requests yet</h4>
                                <p>New requests will appear here when they become available.</p>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

    </div>

</div>

<style>
    .viewing-requests-page {
        width: 100%;
        max-width: 100%;
        color: #263445;
        font-family: inherit;
    }

        .viewing-requests-page *,
        .viewing-requests-page *::before,
        .viewing-requests-page *::after {
            box-sizing: border-box;
        }

        .viewing-requests-page .page-heading {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 24px;
        }

            .viewing-requests-page .page-heading h2 {
                margin: 0 0 6px;
                font-size: 25px;
                line-height: 1.3;
                font-weight: 700;
                letter-spacing: -0.5px;
                color: #263445;
            }

            .viewing-requests-page .page-heading p {
                margin: 0;
                font-size: 13px;
                line-height: 1.6;
                color: #788493;
            }

        /* Compact, evenly aligned summary cards */
        .viewing-requests-page .summary-grid {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 16px;
            margin-bottom: 22px;
        }

        .viewing-requests-page .summary-card {
            min-width: 0;
            padding: 18px 19px 16px;
            background: #fff;
            border: 1px solid #e6eaf0;
            border-radius: 10px;
            box-shadow: 0 2px 7px rgba(31, 45, 61, 0.035);
        }

        .viewing-requests-page .summary-card-top {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
            color: #687587;
            font-size: 12px;
            font-weight: 600;
        }

        .viewing-requests-page .summary-indicator {
            display: inline-block;
            flex: 0 0 8px;
            width: 8px;
            height: 8px;
            border-radius: 50%;
        }

        .viewing-requests-page .total-indicator {
            background: #7892b4;
        }

        .viewing-requests-page .pending-indicator {
            background: #dba23e;
        }

        .viewing-requests-page .approved-indicator {
            background: #39a77a;
        }

        .viewing-requests-page .declined-indicator {
            background: #d96b70;
        }

        .viewing-requests-page .summary-number {
            margin: 13px 0 5px;
            font-size: 29px;
            line-height: 1;
            font-weight: 700;
            color: #263445;
        }

        .viewing-requests-page .summary-description {
            font-size: 11px;
            color: #8993a1;
        }

        /* One compact filter row, aligned to the right */
        .viewing-requests-page .request-toolbar {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 10px;
            margin-bottom: 20px;
        }

        .viewing-requests-page .search-field {
            position: relative;
            flex: 1 1 260px;
            max-width: 320px;
            min-width: 170px;
        }

            .viewing-requests-page .search-field input,
            .viewing-requests-page .filter-control {
                width: 100%;
                height: 40px;
                border: 1px solid #e1e6ed;
                border-radius: 7px;
                background-color: #fff;
                color: #475467;
                font: inherit;
                font-size: 12px;
                outline: none;
            }

            .viewing-requests-page .search-field input {
                padding: 0 12px 0 36px;
            }

                .viewing-requests-page .search-field input::placeholder {
                    color: #9aa4b2;
                }

        .viewing-requests-page .search-symbol {
            position: absolute;
            top: 12px;
            left: 13px;
            width: 12px;
            height: 12px;
            border: 1.7px solid #8995a5;
            border-radius: 50%;
        }

            .viewing-requests-page .search-symbol::after {
                position: absolute;
                content: "";
                width: 5px;
                height: 1.7px;
                right: -4px;
                bottom: -2px;
                background: #8995a5;
                transform: rotate(45deg);
                border-radius: 2px;
            }

        .viewing-requests-page .filter-control {
            flex: 0 1 150px;
            min-width: 125px;
            padding: 0 10px;
        }

        .viewing-requests-page .date-control {
            flex-basis: 155px;
        }

        .viewing-requests-page input:disabled,
        .viewing-requests-page select:disabled {
            opacity: 1;
            cursor: not-allowed;
            background-color: #fff;
            color: #7c8795;
        }

        /* Table panel */
        .viewing-requests-page .requests-panel {
            overflow: hidden;
            background: #fff;
            border: 1px solid #e6eaf0;
            border-radius: 10px;
            box-shadow: 0 2px 7px rgba(31, 45, 61, 0.035);
        }

        .viewing-requests-page .table-heading {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            padding: 19px 20px;
            border-bottom: 1px solid #edf0f4;
        }

            .viewing-requests-page .table-heading h3 {
                margin: 0 0 5px;
                font-size: 15px;
                font-weight: 700;
                color: #263445;
            }

            .viewing-requests-page .table-heading p {
                margin: 0;
                font-size: 12px;
                color: #8993a1;
            }

        .viewing-requests-page .request-count {
            flex-shrink: 0;
            padding: 5px 9px;
            border: 1px solid #e6eaf0;
            border-radius: 5px;
            background: #f8fafc;
            color: #657286;
            font-size: 11px;
            font-weight: 600;
        }

        .viewing-requests-page .requests-table {
            width: 100%;
            margin: 0;
            border-collapse: collapse;
            text-align: left;
        }

            .viewing-requests-page .requests-table thead th {
                padding: 14px 18px;
                background: #f8fafc;
                border-bottom: 1px solid #e8edf2;
                color: #758194;
                font-size: 10px;
                font-weight: 700;
                letter-spacing: 0.45px;
                text-transform: uppercase;
                white-space: nowrap;
            }

            .viewing-requests-page .requests-table .action-heading {
                text-align: right;
            }

            .viewing-requests-page .requests-table tbody td {
                padding: 0;
                border: 0;
            }

        .viewing-requests-page .empty-state {
            padding: 44px 20px 46px;
            text-align: center;
        }

        .viewing-requests-page .empty-state-mark {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 40px;
            height: 40px;
            margin: 0 auto 13px;
            border: 1px solid #e5eaf0;
            border-radius: 10px;
            background: #f8fafc;
            color: #a2adbb;
            font-size: 20px;
        }

        .viewing-requests-page .empty-state h4 {
            margin: 0 0 7px;
            color: #465366;
            font-size: 13px;
            font-weight: 700;
        }

        .viewing-requests-page .empty-state p {
            margin: 0;
            color: #8b96a5;
            font-size: 12px;
            line-height: 1.6;
        }

    @@media (max-width: 1100px) {
        .viewing-requests-page .summary-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 700px) {
        .viewing-requests-page .page-heading h2 {
            font-size: 22px;
        }

        .viewing-requests-page .request-toolbar {
            align-items: stretch;
            flex-direction: column;
        }

        .viewing-requests-page .search-field,
        .viewing-requests-page .filter-control {
            width: 100%;
            max-width: none;
            flex-basis: 40px;
        }

        .viewing-requests-page .table-heading {
            padding: 16px;
        }

        .viewing-requests-page .requests-table thead th {
            padding: 13px 14px;
        }

        .viewing-requests-page .empty-state {
            min-width: 320px;
        }
    }

    @@media (max-width: 420px) {
        .viewing-requests-page .summary-grid {
            gap: 10px;
        }

        .viewing-requests-page .summary-card {
            padding: 15px 12px;
        }

        .viewing-requests-page .summary-card-top {
            font-size: 11px;
        }

        .viewing-requests-page .summary-number {
            font-size: 25px;
        }
    }
</style>
```