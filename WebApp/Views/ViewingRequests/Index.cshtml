        }

        .viewing-requests-page .vr-when-cell {
            min-width: 190px;
            white-space: normal;
        }

        .viewing-requests-page .vr-email-cell {
            min-width: 190px;
            overflow-wrap: anywhere;
        }

        .viewing-requests-page .empty-state {
            padding: 44px 20px 46px;
            text-align: center;
        }

        .viewing-requests-page .empty-state-mark {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 40px;
            height: 40px;
            margin: 0 auto 13px;
            border: 1px solid #e5eaf0;
            border-radius: 10px;
            background: #f8fafc;
            color: #a2adbb;
