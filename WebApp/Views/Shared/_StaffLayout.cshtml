@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    string Active(string name) => string.Equals(controller, name, StringComparison.OrdinalIgnoreCase) ? "active" : "";
    var userName = User?.Identity?.IsAuthenticated == true ? User.Identity!.Name : "Staff Member";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Easy Rentals Staff</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/feedback.css" asp-append-version="true" />
</head>
<body>
    <div class="er-shell">

        <aside class="er-sidebar">
            <a class="er-logo" asp-controller="Dashboard" asp-action="Index">
                <img src="~/images/easy-rentals-group-logo.png" alt="Easy Rentals Group" />
            </a>

            <ul class="er-nav">
                <li>
                    <a asp-controller="Dashboard" asp-action="Index" class="@Active("Dashboard")">
                        <svg viewBox="0 0 24 24"><path d="M3 11l9-8 9 8" /><path d="M5 10v10h5v-6h4v6h5V10" /></svg>
                        Dashboard
                    </a>
                </li>
                <li>
                    <a asp-controller="ViewingRequests" asp-action="Index" class="@Active("ViewingRequests")">
                        <svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="16" rx="2" /><path d="M3 10h18M8 3v4M16 3v4" /></svg>
                        Viewing Requests
                    </a>
                </li>
                <li>
                    <a asp-controller="Enquiries" asp-action="Index" class="@Active("Enquiries")">
                        <svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="M3 7l9 6 9-6" /></svg>
                        Enquiries
                    </a>
                </li>
                <li>
                    <a asp-controller="Rooms" asp-action="Index" class="@Active("Rooms")">
                        <svg viewBox="0 0 24 24"><path d="M3 5v14M3 15h18v4M21 15v-3a3 3 0 0 0-3-3h-7v6" /></svg>
                        Rooms
                    </a>
                </li>
                <li>
                    <a asp-controller="Feedback" asp-action="Index" class="@Active("Feedback")">
                        <svg viewBox="0 0 24 24"><path d="M4 4h16v12H9l-5 4z" /><path d="M12 8v3M12 13.5v.01" /></svg>
                        Feedback
                    </a>
                </li>
                <li>
                    <a asp-controller="StaffProfile" asp-action="Index" class="@Active("StaffProfile")">
                        <svg viewBox="0 0 24 24"><circle cx="9" cy="8" r="4" /><path d="M2 21c0-4 3-6 7-6M15 20l1-3 5-5 2 2-5 5z" /></svg>
                        Staff Profile
                    </a>
                </li>
                <li>
                    <a asp-controller="Account" asp-action="Logout" class="logout">
                        <svg viewBox="0 0 24 24"><path d="M9 4H5a1 1 0 0 0-1 1v14a1 1 0 0 0 1 1h4" /><path d="M10 12h10M16 8l4 4-4 4" /></svg>
                        Logout
                    </a>
                </li>
            </ul>
        </aside>

        <div class="er-main">
            <header class="er-topbar">
                <h2>@(ViewData["PageTitle"] ?? ViewData["Title"])</h2>
                <span class="er-user-pill">@userName</span>
            </header>

            @RenderBody()
        </div>
    </div>
</body>
</html>