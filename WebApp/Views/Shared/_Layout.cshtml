@{
    var staffName = Context.Session.StaffName();
    var current = ViewContext.RouteData.Values["controller"]?.ToString();
    var staffEmail = Context.Session.GetString("staff_email");
    var initials = string.Concat((staffName ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries)
        .Take(2).Select(p => char.ToUpper(p[0])));
    if (initials.Length == 0) { initials = "?"; }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Easy Rentals Staff</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/account-menu.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="app-page">
    <div class="shell">

        <aside class="sidebar" id="sidebar">
            <div class="sidebar-logo">
                <img src="~/images/logo.png" alt="Easy Rentals Group" />
            </div>

            <nav class="menu">
                <a class="menu-item @(current == "Dashboard" ? "active" : "")" asp-controller="Dashboard" asp-action="Index">
                    <svg viewBox="0 0 24 24"><path d="M3 11l9-8 9 8"/><path d="M5 10v10h5v-6h4v6h5V10"/></svg>
                    Dashboard
                </a>

                <a class="menu-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "ViewingRequests" ? "active" : "")"
                   asp-controller="ViewingRequests"
                   asp-action="Index">
                    <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="17" rx="2" /><path d="M7 2v4M17 2v4M3 9h18" /></svg>
                    Viewing Requests

                </a>

                <a class="menu-item @(current == "Enquiries" ? "active" : "")" asp-controller="Enquiries" asp-action="Index">
                    <svg viewBox="0 0 24 24"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 7l10 7 10-7"/></svg>
                    Enquiries
                </a>

                    <svg viewBox="0 0 24 24"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 7l10 7 10-7"/></svg>
                    Enquiries
                </a>
                <span class="menu-item disabled" title="Coming soon">
                    <svg viewBox="0 0 24 24"><path d="M2 19V5M2 15h20v4M22 15v-3a3 3 0 0 0-3-3h-8v6"/><circle cx="6.5" cy="11" r="1.8"/></svg>
                    Rooms
                </span>
                <span class="menu-item disabled" title="Coming soon">
                    <svg viewBox="0 0 24 24"><path d="M4 4h16v12H9l-5 4z"/><path d="M12 7.5v4M12 13.8v.1"/></svg>
                    Feedback
                </span>
                <a class="menu-item @(current == "Profile" ? "active" : "")" asp-controller="Profile" asp-action="Index">
                    <svg viewBox="0 0 24 24"><circle cx="9" cy="8" r="4"/><path d="M2 21c0-3.5 3-6 7-6M15 21l1-4 5-5 3 3-5 5z"/></svg>
                    Staff Profile
                </a>
                
            </nav>
        </aside>

        <div class="sidebar-backdrop" id="sidebar-backdrop"></div>

        <div class="content">
            <header class="topbar">
                <button type="button" class="menu-toggle" id="menu-toggle" aria-label="Open menu">
                    <svg viewBox="0 0 24 24"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
                </button>
                <span class="topbar-title">@ViewData["Title"]</span>
                <div class="acct-wrap">
                    <button type="button" class="acct" id="acct-btn" aria-haspopup="true" aria-expanded="false" aria-controls="acct-menu">
                        <span class="acct-av" aria-hidden="true">@initials</span>
                        <span class="acct-name">@staffName</span>
                    </button>
                    <div class="acct-menu" id="acct-menu" hidden>
                        <div class="acct-who">
                            <span class="acct-av big" aria-hidden="true">@initials</span>
                            <div>
                                <strong>@staffName</strong>
                                @if (!string.IsNullOrEmpty(staffEmail))
                                {
                                    <span>@staffEmail</span>
                                }
                            </div>
                        </div>
                        <a class="acct-item" asp-controller="Profile" asp-action="Index">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-6 8-6s8 2 8 6"/></svg>
                            My profile
                        </a>
                        <div class="acct-sep"></div>
                        <a class="acct-item out" asp-controller="Account" asp-action="Logout">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 4H5a1 1 0 0 0-1 1v14a1 1 0 0 0 1 1h4"/><path d="M16 8l4 4-4 4M20 12H9"/></svg>
                            Log out
                        </a>
                    </div>
                </div>
            </header>

            <main class="page @(ViewData["PageClass"])">
                @RenderBody()
            </main>
        </div>
    </div>
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
