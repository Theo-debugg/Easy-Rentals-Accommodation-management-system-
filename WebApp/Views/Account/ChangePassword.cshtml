@model ChangePasswordViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Set your password";
}

<div class="auth-head">
    <div class="auth-icon">
        <svg viewBox="0 0 24 24"><circle cx="8" cy="15" r="4"/><path d="M11 12l9-9M16 7l3 3M14 9l2 2"/></svg>
    </div>
    <div>
        <div class="eyebrow">First sign in</div>
        <h1>Set your password</h1>
    </div>
</div>

<div class="notice">You are using the temporary password. Please choose a new password to secure your account.</div>

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="alert">@Model.Error</div>
}

<form method="post" asp-controller="Account" asp-action="ChangePassword">
    <label asp-for="NewPassword" class="field-label">New password <span class="req">*</span></label>
    <div class="pw-wrap">
        <input asp-for="NewPassword" type="password" class="field" required minlength="8" autocomplete="new-password" />
        <button type="button" class="pw-toggle" data-target="NewPassword" aria-label="Show password">
            <svg class="eye-on" viewBox="0 0 24 24"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg>
            <svg class="eye-off" viewBox="0 0 24 24"><path d="M3 3l18 18"/><path d="M10.6 5.1A10 10 0 0 1 12 5c6.4 0 10 7 10 7a17 17 0 0 1-3.2 4.1M6.5 6.6C3.7 8.4 2 12 2 12s3.6 7 10 7c1.7 0 3.2-.4 4.5-1"/><path d="M9.9 9.9a3 3 0 0 0 4.2 4.2"/></svg>
        </button>
    </div>

    <label asp-for="ConfirmPassword" class="field-label">Confirm password <span class="req">*</span></label>
    <div class="pw-wrap">
        <input asp-for="ConfirmPassword" type="password" class="field" required minlength="8" autocomplete="new-password" />
        <button type="button" class="pw-toggle" data-target="ConfirmPassword" aria-label="Show password">
            <svg class="eye-on" viewBox="0 0 24 24"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg>
            <svg class="eye-off" viewBox="0 0 24 24"><path d="M3 3l18 18"/><path d="M10.6 5.1A10 10 0 0 1 12 5c6.4 0 10 7 10 7a17 17 0 0 1-3.2 4.1M6.5 6.6C3.7 8.4 2 12 2 12s3.6 7 10 7c1.7 0 3.2-.4 4.5-1"/><path d="M9.9 9.9a3 3 0 0 0 4.2 4.2"/></svg>
        </button>
    </div>

    <button type="submit" class="btn-primary">
        Save password
        <svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
    </button>
</form>
