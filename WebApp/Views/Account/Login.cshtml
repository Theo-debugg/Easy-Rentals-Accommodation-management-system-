@model LoginViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Sign in";
}

<div class="auth-head">
    <div class="auth-icon" style="background:none; width:120px; height:54px;">
        <img src="~/images/logo.png" alt="Easy Rentals Group"
             style="width:100%; height:100%; object-fit:contain;" />
    </div>
    <div>
        <div class="eyebrow">Account access</div>
        <h1>Sign in</h1>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="alert">@Model.Error</div>
}

<form method="post" asp-controller="Account" asp-action="Login">
    <label asp-for="Email" class="field-label">Email <span class="req">*</span></label>
    <input asp-for="Email" type="email" class="field" required autocomplete="username" />

    <label asp-for="Password" class="field-label">Password <span class="req">*</span></label>
    <div class="pw-wrap">
        <input asp-for="Password" type="password" class="field" required autocomplete="current-password" />
        <button type="button" class="pw-toggle" data-target="Password" aria-label="Show password">
            <svg class="eye-on" viewBox="0 0 24 24"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg>
            <svg class="eye-off" viewBox="0 0 24 24"><path d="M3 3l18 18"/><path d="M10.6 5.1A10 10 0 0 1 12 5c6.4 0 10 7 10 7a17 17 0 0 1-3.2 4.1M6.5 6.6C3.7 8.4 2 12 2 12s3.6 7 10 7c1.7 0 3.2-.4 4.5-1"/><path d="M9.9 9.9a3 3 0 0 0 4.2 4.2"/></svg>
        </button>
    </div>

  
        <button type="submit" class="btn-primary">
        Sign in
        <svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
    </button>
</form>


