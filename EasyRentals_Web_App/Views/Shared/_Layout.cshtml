<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Easy Rentals</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        .sidebar { min-height: 100vh; background: #f8f9fa; border-right: 1px solid #ddd; }
        .sidebar .nav-link { color: #333; padding: 15px 20px; font-weight: 500; border-bottom: 1px solid #eee; }
        .sidebar .nav-link:hover { background: #e9ecef; }
        .sidebar .nav-link i { margin-right: 10px; }
    </style>
</head>

<body>
    <div class="container-fluid">
        <div class="row">
            <!-- Sidebar -->
            <div class="col-md-2 sidebar p-0">
                <div class="p-3 text-center border-bottom">
                    <icon></icon><h4>Easy Rentals</h4>
                </div>
                <nav class="nav flex-column">
                    <a class="nav-link" asp-controller="Dashboard" asp-action="Index">Dashboard</a>
                    <a class="nav-link" href="#">Viewing Requests</a>
                    <a class="nav-link" href="#">Enquiries</a>
                    <a class="nav-link" href="#">Rooms</a>
                    <a class="nav-link" href="#">Feedback</a>
                    <a class="nav-link" href="#">Staff Profile</a>
                    <a class="nav-link" asp-controller="Account" asp-action="Logout">Logout</a>
                </nav>
            </div>
            <!-- Main Content -->
            <div class="col-md-10 p-4">
                @RenderBody()
            </div>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>